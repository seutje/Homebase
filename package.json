{
  "name": "homebase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src *.json *.ts *.js *.md",
    "format:check": "prettier --check src *.json *.ts *.js *.md",
    "test": "vitest run --passWithNoTests",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
